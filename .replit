modules = ["python-3.12"]

[nix]
channel = "stable-25_05"
packages = ["gitFull", "playwright-driver", "gcc", "glib", "nspr", "nss", "atk", "at-spi2-atk", "dbus", "cups", "mesa", "libxkbcommon", "alsa-lib", "libdrm", "cairo", "pango", "fontconfig", "freetype", "gtk3", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "chromium"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Session login (VNC)"

[[workflows.workflow]]
name = "Session login (VNC)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "LD_LIBRARY_PATH=\"$(dirname \"$(gcc -print-file-name=libatomic.so.1)\")${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\" python pull_sessions.py --login --browser-exe \"$(command -v chromium)\""

[workflows.workflow.metadata]
outputType = "vnc"
