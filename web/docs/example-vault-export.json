            },
            {
              "type": "text",
              "text": "Is it ready?"
            }
          ],
          "created_at": "2026-11-18T19:20:31.000Z"
        },
        {
          "id": "0e55a9e0-0003-4000-8000-000000000003",
          "index": 3,
          "role": "assistant",
          "segments": [
            {
              "type": "text",
              "text": "It has doubled, so it is ready. Bake today."
            }
          ],
