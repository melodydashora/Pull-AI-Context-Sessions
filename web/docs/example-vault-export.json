          "segments": [
            {
              "type": "text",
              "text": "How often should I feed a new sourdough starter?"
            }
          ]
        },
        {
          "id": "0e55a9e0-0003-4000-8000-000000000001",
          "index": 1,
          "role": "assistant",
          "segments": [
            {
              "type": "text",
              "text": "Twice a day at room temperature.\n\n1. Discard all but 20 g.\n2. Add 40 g flour and 40 g water.\n3. Stir, cover loosely, and wait 12 hours."
            }
          ]
        },
        {
          "id": "0e55a9e0-0003-4000-8000-000000000002",
          "index": 2,
          "role": "user",
          "segments": [
            {
              "type": "text",
              "text": "Here is a photo of the jar after six hours."
